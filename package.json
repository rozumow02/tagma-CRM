{
  "name": "distribution-crm",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite  --host --port 8000",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "build-only": "vite build",
    "type-check": "vue-tsc --build --force",
    "lint": "eslint \"src/**/*.{vue,js,jsx,cjs,mjs,ts,tsx,cts,mts}\" \"*.{js,cjs,mjs,ts,cts,mts}\" --no-error-on-unmatched-pattern --ignore-path .gitignore",
    "lint:fix": "npm run lint -- --fix",
    "format": "prettier --write src/",
    "release": "standard-version"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.1",
    "@vueuse/core": "^11.1.0",
    "axios": "^1.7.4",
    "dompurify": "^3.4.17",
    "element-plus": "^2.8.4",
    "lucide-vue-next": "^0.441.0",
    "pinia": "^2.2.2",
    "quill": "^2.0.3",
    "sass": "^1.80.6",
    "v-viewer": "^3.0.13",
    "viewerjs": "^1.11.6",
    "vue": "^3.4.29",
    "vue-draggable-plus": "^0.6.0",
    "vue-i18n": "^9.14.0",
    "vue-router": "^4.3.3",
    "vue3-toastify": "^0.2.2"
  },
  "devDependencies": {
    "@rushstack/eslint-patch": "^1.8.0",
    "@tsconfig/node20": "^20.1.4",
    "@types/node": "^20.14.15",
    "@vitejs/plugin-vue": "^5.0.5",
    "@vue/eslint-config-prettier": "^9.0.0",
    "@vue/eslint-config-typescript": "^13.0.0",
    "@vue/tsconfig": "^0.5.1",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.0",
    "eslint-plugin-vue": "^9.23.0",
    "npm-run-all2": "^6.2.0",
    "postcss": "^8.4.41",
    "prettier": "^3.2.5",
    "sass-embedded": "^1.77.8",
    "standard-version": "^9.5.0",
    "tailwindcss": "^3.4.10",
    "typescript": "~5.4.0",
    "unplugin-vue-components": "^0.27.4",
    "vite": "^5.3.1",
    "vue-tsc": "^2.0.21"
  }
